# Used by docker-compose.yml. Copy to .env next to docker-compose.yml and fill in the values.
# For local development without Docker, use backend/.env.example instead.

# Required. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional. Without it the app answers from an offline mock and the benchmark is retrieval-only.
GROQ_API_KEY=

# Origin(s) the browser loads the app from, as a JSON list.
CORS_ORIGINS=["http://localhost:8000"]
