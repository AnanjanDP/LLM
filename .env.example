# Production RAG LLM Stack - Environment Configuration
PROJECT_NAME="RAG Intelligence Platform"
API_V1_STR="/api/v1"
SECRET_KEY="dev-secret-key-change-in-production-min-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER="groq"
DEFAULT_LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30

# API Keys
GROQ_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Vector Index & Embedding Configuration
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
FAISS_INDEX_PATH="data/faiss.index"
FAISS_DOCS_PATH="data/documents.npy"
