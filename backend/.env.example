# Local development settings. Copy this file to backend/app/.env and edit it.
# (Docker Compose uses the .env.example in the repository root instead.)
ENVIRONMENT="development"          # development | production | test. Production refuses weak settings.
PROJECT_NAME="RAG Intelligence Platform"
API_V1_STR="/api/v1"

# Generate a real key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the server refuses to start with this example key, a key under 32 characters, or CORS "*".
SECRET_KEY="dev-secret-key-change-in-production-min-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./app.db"

# Redis (optional: caching is skipped if it is unreachable)
REDIS_URL="redis://localhost:6379/0"

# LLM. Without GROQ_API_KEY the app uses an offline mock and retrieval-only evaluation.
DEFAULT_LLM_PROVIDER="groq"
DEFAULT_LLM_MODEL="openai/gpt-oss-120b"
LLM_FALLBACK_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
GROQ_API_KEY=""

# Vector store / RAG
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
FAISS_INDEX_PATH="data/faiss.index"
FAISS_DOCS_PATH="data/documents.json"
RAG_TOP_K=4
CHUNK_SIZE=200
CHUNK_OVERLAP=40

# Uploads
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=500

# Rate limits (slowapi syntax)
AUTH_RATE_LIMIT="10/minute"
EVAL_RATE_LIMIT="6/minute"

# CORS: explicit origins only
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
